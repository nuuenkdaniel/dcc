HOST=127.0.0.1
PORT=5301
LOG_LEVEL=info

# Keep .env private and out of Git. Do not use Nextcloud's main password.
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_SYNC_ENABLED=false
DAYMARK_USERNAME=
DAYMARK_PASSWORD=
APP_ORIGIN=http://localhost:5173
CALENDAR_SYNC_INTERVAL_SECONDS=600
CALENDAR_PAST_DAYS=30
CALENDAR_FUTURE_MONTHS=12
CALENDAR_TEST_CALENDAR=Personal

# Private authenticated Hermes adapter. Credentials never reach the browser.
# Development: loopback SSH tunnel to the isolated daymark-curator profile.
HERMES_CURATOR_URL=http://127.0.0.1:3012/curate
HERMES_CURATOR_TOKEN=
